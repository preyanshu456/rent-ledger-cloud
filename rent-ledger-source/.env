# Copy this file to .env (same folder as server.js) for local development.
# Never commit .env — it holds your Razorpay secret. On Railway, add these as
# service Variables instead of using a file.

# Razorpay: Dashboard → Account & Settings → API Keys (Test Mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: only if you add the Razorpay webhook (see RAZORPAY_SETUP.md)
RAZORPAY_WEBHOOK_SECRET=
