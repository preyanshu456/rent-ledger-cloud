# Copy this file to .env (same folder as server.js) for local development.
# Never commit .env — it holds secrets. On Railway, add these as service
# Variables instead of using a file. Every setting is optional.

# ---------- Online payments (see RAZORPAY_SETUP.md) ----------
# Razorpay: Dashboard → Account & Settings → API Keys (Test Mode keys start with rzp_test_)
RAZORPAY_KEY_ID= rzp_live_TlPeQqElWmjtYH
RAZORPAY_KEY_SECRET=mkxD0B0nTw1CmJDvKxQbWLlI
# Optional backup path if a tenant closes the page right after paying
RAZORPAY_WEBHOOK_SECRET=

# ---------- Password reset delivery (see PASSWORD_RESET_SETUP.md) ----------
# Email via Resend
RESEND_API_KEY=
OTP_FROM_EMAIL=
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Country code added to 10-digit numbers (default 91 = India)
DEFAULT_PHONE_COUNTRY_CODE=

# ---------- Rent reminders and tenant messages ----------
# simulate = nothing leaves the server: email/SMS/WhatsApp are marked "simulated".
# live     = approved messages are sent through Resend / Twilio.
# Default: live when NODE_ENV=production, simulate everywhere else.
NOTIFY_MODE=
# Sender for reminder emails (falls back to OTP_FROM_EMAIL)
NOTIFY_FROM_EMAIL=
# WhatsApp sender through Twilio, e.g. whatsapp:+14155238886 (needs the Twilio
# account SID and token above, and an approved WhatsApp sender/template)
TWILIO_WHATSAPP_FROM=

# ---------- Rent Ledger AI (optional) ----------
# Without these the assistant works in "basic mode" (built-in rules, no AI).
# With them, the owner still has to switch AI on in Settings.
# anthropic | openai  (openai = any OpenAI-compatible chat-completions API)
AI_PROVIDER=
AI_API_KEY=
# The exact model name your provider gives you. Required; there is no default.
AI_MODEL=
# Only for OpenAI-compatible services other than api.openai.com, or a proxy
AI_BASE_URL=

# ---------- Server ----------
# Where the database (rent-ledger.sqlite), documents and backups live. The
# Docker image sets /data; on Railway a volume must be mounted there or data is
# lost on every deploy. A db.json from older versions is imported on first start.
DATA_DIR=
# Port to listen on (Railway sets this itself)
PORT=
# Time zone for "this month" and "paid on" dates (default Asia/Kolkata)
APP_TIMEZONE=

# ---------- Security ----------
# Days a sign-in stays valid (default 30)
SESSION_TTL_DAYS=
# Days a tenant invite code stays valid (default 7)
INVITE_TTL_DAYS=
# If set, creating the first owner account requires this code (8+ characters).
# Useful for a fresh deployment or a staging copy. With the code, further
# landlords can also create their own (separate) organisation.
OWNER_SETUP_CODE=
# open = anyone may create a new landlord organisation. Leave empty to allow
# only the first owner (and people who have OWNER_SETUP_CODE).
OWNER_SIGNUP=
# Content-Security-Policy runs in report-only mode by default. Set to true
# after checking the browser console shows no CSP reports.
CSP_ENFORCE=
# Header holding the visitor's real IP. Defaults to x-real-ip on Railway.
CLIENT_IP_HEADER=
# Extra origins allowed to call the API (e.g. a native app wrapper), comma separated
CORS_ORIGINS=

# ---------- Backups and logs ----------
# Database backups kept in DATA_DIR/backups (default 30)
BACKUP_KEEP=
# Hours between automatic database backups (default 24)
BACKUP_INTERVAL_HOURS=
# debug | info | warn | error | silent (default info)
LOG_LEVEL=
